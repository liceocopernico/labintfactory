msgid "A limit was reached."
msgstr "È stato raggiunto un limite."

msgid "Analog gain"
msgstr "Guadagno analogico"

msgid "Bluetooth"
msgstr "Bluetooth"

msgid "Busy"
msgstr "Occupato"

#, python-brace-format
msgid "Cannot open {port}."
msgstr "Impossibile aprire {port}."

msgid "Connecting"
msgstr "Connessione in corso"

msgid "Connection lost"
msgstr "Connessione persa"

msgid "Disconnected"
msgstr "Disconnesso"

msgid "Drive level of the LED, 0 = off."
msgstr "Livello di pilotaggio del LED, 0 = spento."

msgid "Each value is the mean of this many conversions."
msgstr "Ogni valore è la media di questo numero di conversioni."

msgid "Error"
msgstr "Errore"

msgid "Full scale"
msgstr "Fondo scala"

msgid "Full spectrum"
msgstr "Spettro completo"

msgid "Illuminance"
msgstr "Illuminamento"

msgid "Infrared"
msgstr "Infrarosso"

msgid "Integration time"
msgstr "Tempo di integrazione"

msgid "LED colour"
msgstr "Colore del LED"

msgid "LED power"
msgstr "Potenza del LED"

#, python-brace-format
msgid "Lost the connection on {port}."
msgstr "Connessione persa su {port}."

msgid "Malformed error reply from the board."
msgstr "La scheda ha inviato una risposta di errore malformata."

msgid "Malformed line from the board (unbalanced quotes)."
msgstr "La scheda ha inviato una riga malformata (virgolette non bilanciate)."

#, python-brace-format
msgid "No simulated device is available for {plugin}."
msgstr "Nessun dispositivo simulato disponibile per {plugin}."

msgid "Nominal amplification: 1×, 25×, 428× or 9876×."
msgstr "Amplificazione nominale: 1×, 25×, 428× o 9876×."

#, python-brace-format
msgid ""
"Permission denied on {port}. Add your user to the 'dialout' group (or 'uucp' on Arch), then log out and "
"back in."
msgstr ""
"Permesso negato su {port}. Aggiungi il tuo utente al gruppo 'dialout' (o 'uucp' su Arch), poi esci e "
"rientra nella sessione."

#, python-brace-format
msgid "Permission denied on {port}. Close other programs that use it."
msgstr "Permesso negato su {port}. Chiudi gli altri programmi che la usano."

msgid "Photometer (TSL2591 + LED)"
msgstr "Fotometro (TSL2591 + LED)"

msgid "Read settings from device"
msgstr "Leggi le impostazioni dal dispositivo"

msgid "Readings per value"
msgstr "Letture per valore"

msgid "Ready"
msgstr "Pronto"

msgid "Settings read from the board."
msgstr "Impostazioni lette dalla scheda."

msgid "Stopped."
msgstr "Interrotto."

msgid "That device is not connected."
msgstr "Quel dispositivo non è collegato."

msgid "The board reports no functions."
msgstr "La scheda non dichiara alcuna funzione."

#, python-brace-format
msgid "The board sent an invalid value for {key!r}."
msgstr "La scheda ha inviato un valore non valido per {key!r}."

msgid "The board was disconnected."
msgstr "La scheda è stata scollegata."

msgid "The board's ID? reply is incomplete."
msgstr "La risposta della scheda a ID? è incompleta."

#, python-brace-format
msgid "The board's reply lacks {key!r}."
msgstr "Nella risposta della scheda manca {key!r}."

msgid "The colour of the LED fitted in the photometer. It sets the allowed power."
msgstr "Il colore del LED montato nel fotometro. Determina la potenza consentita."

msgid "The connection to the board is closed."
msgstr "La connessione con la scheda è chiusa."

msgid "This setting is fixed by your administrator."
msgstr "Questa impostazione è stabilita dall'amministratore."

msgid "USB"
msgstr "USB"

msgid "Unexpected line from the board."
msgstr "Riga inattesa dalla scheda."

#, python-brace-format
msgid "Unknown command: {key}"
msgstr "Comando sconosciuto: {key}"

#, python-brace-format
msgid "Unknown setting: {key}"
msgstr "Impostazione sconosciuta: {key}"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "blue"
msgstr "blu"

msgid "counts"
msgstr "conteggi"

#, python-brace-format
msgid "error {code}"
msgstr "errore {code}"

msgid "green"
msgstr "verde"

msgid "no answer to PING"
msgstr "nessuna risposta a PING"

msgid "orange"
msgstr "arancione"

msgid "red"
msgstr "rosso"

msgid "simulated"
msgstr "simulato"

#, python-brace-format
msgid "{board} did not answer in time."
msgstr "{board} non ha risposto in tempo."

#, python-brace-format
msgid "{board} did not finish {verb} in time."
msgstr "{board} non ha completato {verb} in tempo."

#, python-brace-format
msgid "{board} is already connected."
msgstr "{board} è già collegata."

#, python-brace-format
msgid "{board} speaks protocol version {version}; this LabDaemon supports {supported}."
msgstr "{board} usa la versione {version} del protocollo; questo LabDaemon supporta {supported}."

#, python-brace-format
msgid "{label}: choose one of {options}."
msgstr "{label}: scegli tra {options}."

#, python-brace-format
msgid "{label}: {value!r} is not a valid value."
msgstr "{label}: {value!r} non è un valore valido."

#, python-brace-format
msgid "{label}: {value} is outside {minimum}–{maximum}{unit}."
msgstr "{label}: {value} è fuori dall'intervallo {minimum}–{maximum}{unit}."

#, python-brace-format
msgid "{port} is in use by another program."
msgstr "{port} è in uso da un altro programma."

#, python-brace-format
msgid "{port} is not there any more. Is the board plugged in?"
msgstr "{port} non è più presente. La scheda è collegata?"

#, python-brace-format
msgid "{target} does not answer. Is it a LabDaemon board with LabInt firmware?"
msgstr "{target} non risponde. È una scheda LabDaemon con firmware LabInt?"

